{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session_hook.py", "on-start"],
            "timeout": 10,
            "statusMessage": "Tracking session start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session_hook.py", "on-end"],
            "timeout": 10,
            "statusMessage": "Finalizing session record"
          }
        ]
      }
    ]
  }
}
